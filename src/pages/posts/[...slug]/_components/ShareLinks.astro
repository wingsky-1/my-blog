---
import IconX from "@/assets/icons/socials/x.svg";
import IconTelegram from "@/assets/icons/socials/telegram.svg";
type Props = { title: string };
const pageUrl = Astro.url.href;
const pageTitle = Astro.props.title;
const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(pageTitle)}&url=${encodeURIComponent(pageUrl)}`;
const telegramUrl = `https://t.me/share/url?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(pageTitle)}`;
---

<div class="my-5 flex flex-wrap items-center gap-3" data-pagefind-ignore>
  <span class="text-muted-foreground text-sm">分享文章</span>
  <a
    href={xUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="分享到 X"
    title="分享到 X"
    class="share-icon"
  >
    <IconX class="size-5 fill-current" />
  </a>
  <a
    href={telegramUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="分享到 Telegram"
    title="分享到 Telegram"
    class="share-icon"
  >
    <IconTelegram class="size-5 fill-current" />
  </a>
  <button
    type="button"
    id="share-copy-link"
    aria-label="复制文章链接"
    title="复制链接"
    class="share-icon"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      class="size-5"
      aria-hidden="true"
      ><rect x="8" y="8" width="12" height="12" rx="2"></rect><path
        d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg
    >
  </button>
  <button
    type="button"
    id="share-native"
    aria-label="使用系统分享"
    title="系统分享"
    class="share-icon hidden"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      class="size-5"
      aria-hidden="true"
      ><path d="M12 16V3m0 0L7 8m5-5 5 5"></path><path
        d="M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6"></path></svg
    >
  </button>
  <span
    id="share-status"
    class="text-muted-foreground text-xs"
    role="status"
    aria-live="polite"></span>
</div>

<style>
  .share-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    color: var(--color-foreground);
  }
  .share-icon:hover,
  .share-icon:focus-visible {
    color: var(--color-accent);
    border-color: currentColor;
  }
  .share-icon.hidden {
    display: none;
  }
</style>

<script>
  function initPostSharing() {
    const copy = document.querySelector<HTMLButtonElement>("#share-copy-link");
    const native = document.querySelector<HTMLButtonElement>("#share-native");
    const status = document.querySelector<HTMLElement>("#share-status");
    if (!copy || !native || !status) return;
    copy.onclick = async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        status.textContent = "链接已复制";
      } catch {
        status.textContent = "复制失败，请从地址栏复制";
      }
    };
    if (navigator.share) {
      native.classList.remove("hidden");
      native.onclick = async () => {
        try {
          await navigator.share({
            title: document.title,
            url: window.location.href,
          });
        } catch {
          /* Sharing may be cancelled by the user. */
        }
      };
    }
  }
  document.addEventListener("astro:page-load", initPostSharing);
  initPostSharing();
</script>
