---
const pageUrl = Astro.url.href;
const pageTitle = Astro.props.title ?? "技术笔记";
const weiboUrl = `https://service.weibo.com/share/share.php?url=${encodeURIComponent(pageUrl)}&title=${encodeURIComponent(pageTitle)}`;
---

<div class="my-4 flex flex-wrap items-center gap-3 text-sm" data-pagefind-ignore>
  <span class="text-muted-foreground">分享文章：</span>
  <a
    href={weiboUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="hover:text-accent underline decoration-dashed underline-offset-4"
  >
    微博
  </a>
  <button type="button" id="share-copy-link" class="hover:text-accent underline decoration-dashed underline-offset-4">
    复制链接
  </button>
  <button type="button" id="share-native" class="hover:text-accent hidden underline decoration-dashed underline-offset-4">
    系统分享
  </button>
  <span id="share-status" class="text-muted-foreground" role="status" aria-live="polite"></span>
</div>

<script>
  function initPostSharing() {
    const copy = document.querySelector<HTMLButtonElement>("#share-copy-link");
    const native = document.querySelector<HTMLButtonElement>("#share-native");
    const status = document.querySelector<HTMLElement>("#share-status");
    if (!copy || !native || !status) return;

    copy.onclick = async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        status.textContent = "链接已复制";
      } catch {
        status.textContent = "复制失败，请从地址栏复制";
      }
    };

    if (navigator.share) {
      native.classList.remove("hidden");
      native.onclick = async () => {
        try {
          await navigator.share({
            title: document.title,
            url: window.location.href,
          });
        } catch {
          // User may cancel the OS-native share dialog.
        }
      };
    }
  }

  document.addEventListener("astro:page-load", initPostSharing);
  initPostSharing();
</script>
