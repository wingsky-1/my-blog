---
type Props = { headings: { depth: number; slug: string; text: string }[] };
import PostToc from "./PostToc.astro";
const { headings } = Astro.props;
---

<div class="post-responsive-layout">
  <div class="post-reading-column">
    <PostToc {headings} />
    <slot />
  </div>
  <div class="post-toc-column" aria-hidden="true">
    <slot name="desktop-toc" />
  </div>
</div>

<style>
  .post-responsive-layout { min-width: 0; }
  .post-reading-column { min-width: 0; }
  .post-toc-column { display: none; }
  @media (min-width: 1280px) {
    .post-responsive-layout {
      position: relative;
      left: 50%;
      transform: translateX(-50%);
      width: min(1120px, calc(100vw - 64px));
      display: grid;
      grid-template-columns: minmax(0, 820px) 230px;
      gap: 3rem;
      align-items: start;
    }
    .post-toc-column { display: block; min-width: 0; }
  }
</style>
