---
type Heading = { depth: number; slug: string; text: string };
type Props = { headings: Heading[]; variant: "mobile" | "desktop" };
const { headings, variant } = Astro.props;
const sections = headings.filter(heading => heading.depth === 2);
---

{
  sections.length > 0 && (
    <>
      {variant === "mobile" && (
        <details class="post-toc-mobile" data-pagefind-ignore>
          <summary>本文目录（{sections.length} 节）</summary>
          <nav aria-label="文章目录">
            <ol>
              {sections.map(heading => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )}
      {variant === "desktop" && (
        <aside
          class="post-toc-desktop"
          aria-label="文章目录"
          data-pagefind-ignore
        >
          <div class="toc-title">本文目录</div>
          <nav>
            <ol>
              {sections.map(heading => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
    </>
  )
}

<style>
  .post-toc-mobile {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    margin-top: 1.25rem;
    position: sticky;
    top: 0.5rem;
    z-index: 20;
    background: var(--color-background);
    padding: 0.75rem 1rem;
    color: var(--color-foreground);
  }
  .post-toc-mobile summary {
    cursor: pointer;
    font-weight: 600;
  }
  .post-toc-mobile ol,
  .post-toc-desktop ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-toc-mobile nav {
    margin-top: 0.75rem;
    max-height: 48vh;
    overflow: auto;
  }
  .post-toc-mobile li,
  .post-toc-desktop li {
    margin: 0.5rem 0;
    line-height: 1.6;
  }
  a {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .post-toc-desktop {
    display: block;
  }
  @media (min-width: 1280px) {
    .post-toc-mobile {
      display: none;
    }
    .post-toc-desktop {
      display: block;
      position: sticky;
      top: 6rem;
      max-height: calc(100vh - 8rem);
      overflow-y: auto;
      font-size: 0.8125rem;
      color: var(--color-muted-foreground);
      scrollbar-width: thin;
    }
    .toc-title {
      font-weight: 600;
      color: var(--color-foreground);
      margin-bottom: 0.75rem;
    }
  }
</style>
