---
type Props = {
  headings: { depth: number; slug: string; text: string }[];
};
const { headings } = Astro.props;
const sections = headings.filter(h => h.depth === 2 || h.depth === 3);
---

{
  sections.length > 0 && (
    <aside class="post-toc" aria-label="文章目录" data-pagefind-ignore>
      <div class="post-toc-title">本文目录</div>
      <nav aria-label="章节导航">
        <ol>
          {sections.map(h => (
            <li class:list={{ "post-toc-sub": h.depth === 3 }}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  )
}

<style>
  .post-toc {
    display: none;
  }
  @media (min-width: 1500px) {
    .post-toc {
      display: block;
      position: fixed;
      top: 7rem;
      left: calc(50% + 340px);
      width: min(220px, calc((100vw - 720px) / 2 - 28px));
      max-height: calc(100vh - 9rem);
      overflow-y: auto;
      font-size: 0.8125rem;
      color: var(--muted-foreground);
      scrollbar-width: thin;
    }
    .post-toc-title {
      font-weight: 600;
      color: var(--foreground);
      margin-bottom: 0.75rem;
    }
    ol {
      padding: 0;
      margin: 0;
      list-style: none;
    }
    li {
      margin: 0.45rem 0;
      line-height: 1.6;
    }
    li.post-toc-sub {
      padding-left: 0.85rem;
    }
    a {
      color: inherit;
      text-decoration: none;
      display: block;
    }
    a:hover,
    a:focus-visible {
      color: var(--accent);
      text-decoration: underline;
    }
  }
</style>
