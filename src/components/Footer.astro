---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-between gap-x-4 gap-y-2 border-t py-5 sm:flex-row-reverse"
  >
    <Socials />
    <div class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-center text-sm sm:justify-start">
      <span>{t.footer.copyright} &#169; {currentYear} {t.footer.allRightsReserved}</span>
      <span class="text-muted-foreground text-xs">
        <span aria-hidden="true" class="hidden sm:inline">· </span>
        基于
        <a
          class="hover:text-accent underline underline-offset-2"
          href="https://astro.build/"
          target="_blank"
          rel="noopener noreferrer">Astro</a
        >、
        <a
          class="hover:text-accent underline underline-offset-2"
          href="https://github.com/satnaing/astro-paper"
          target="_blank"
          rel="noopener noreferrer">AstroPaper</a
        >
        构建，由
        <a
          class="hover:text-accent underline underline-offset-2"
          href="https://pages.cloudflare.com/"
          target="_blank"
          rel="noopener noreferrer">Cloudflare Pages</a
        >
        部署
      </span>
    </div>
  </div>
</footer>
